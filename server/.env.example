# ── Server (.env.example) ─────────────────────────────
# Copy this file to `server/.env` for local development. DO NOT commit secrets.

# Server
PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-strong-secret

# Google Gemini API (rotate if exposed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_UPLOAD=10
RATE_LIMIT_MAX_ANALYZE=20

# FAISS / Vector Store
FAISS_INDEX_DIR=./faiss_indexes
INDEX_TTL_HOURS=24

# RAG config
CHUNK_SIZE=250
CHUNK_OVERLAP=30
TOP_K_RESULTS=2

# CORS - set this to your frontend origin in production (e.g. https://resume-analyzer-beta-rose.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Embedding model
HUGGINGFACE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# ── Server Configuration ────────────────
PORT=5001
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── Google Gemini API (free at aistudio.google.com) ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── File Upload ─────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_UPLOAD=10
RATE_LIMIT_MAX_ANALYZE=20

# ── FAISS & Vector Store ────────────────
FAISS_INDEX_DIR=./faiss_indexes
INDEX_TTL_HOURS=24

# ── RAG Configuration ────────────────────
CHUNK_SIZE=250
CHUNK_OVERLAP=30
TOP_K_RESULTS=2

# ── Embeddings (local, free) ─────────────
HUGGINGFACE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
